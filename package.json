{
  "name": "corewe",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json,mjs --ignore src/**/*.test.js --delay 500 src/app.js",
    "start": "node src/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:arch": "eslint src",
    "ai:install": "cd ai_auditor && py -3 -m venv .venv && .venv\\Scripts\\python -m pip install --upgrade pip && .venv\\Scripts\\pip install -r requirements.txt",
    "ai:start": "cd ai_auditor && .venv\\Scripts\\uvicorn main:app --host 127.0.0.1 --port 8090"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@google-cloud/storage": "^7.18.0",
    "@slack/web-api": "^7.14.1",
    "axios": "^1.13.6",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.1",
    "googleapis": "^166.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.42.0"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.10",
    "vitest": "^3.2.4"
  }
}
